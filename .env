# =============================================================================
# Celery Development Environment
# =============================================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# The EnvCredentialProvider reads env vars in the pattern:
#   {DATABASE_TYPE}_{USER|PASSWORD|HOST|PORT}
#
# Valid DATABASE_TYPE values (from CeleryDatabaseType enum):
#   MONGODB, REDIS, NATS, INFLUXDB, DRAGONFLYDB, MARIADB
# =============================================================================

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_USER=admin
MONGODB_PASSWORD=admin
MONGODB_HOST=localhost
MONGODB_PORT=27017

# ── Redis (Pub/Sub) ────────────────────────────────────────────────────────
REDIS_USER=
REDIS_PASSWORD=redispass
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Redis (Cache) ──────────────────────────────────────────────────────────
# Note: The cache provider also uses the REDIS env prefix, but we run a
# separate container on a different port. When testing both simultaneously,
# adjust the platform registration accordingly.
DRAGONFLYDB_USER=
DRAGONFLYDB_PASSWORD=rediscachepass
DRAGONFLYDB_HOST=localhost
DRAGONFLYDB_PORT=6380

# ── NATS ───────────────────────────────────────────────────────────────────
NATS_USER=
NATS_PASSWORD=natspass
NATS_HOST=localhost
NATS_PORT=4222

# ── InfluxDB ───────────────────────────────────────────────────────────────
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=influxpass
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
